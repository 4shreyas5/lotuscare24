# Copy to .env.local and fill in real values there (.env.local is gitignored,
# .env.example is committed and must never contain real secrets/addresses).
# See docs/FORMS.md for the full explanation of each variable and what
# happens locally when one is left unset.

# Resend (https://resend.com) — sends the internal notification emails for
# the contact, kennismaken, and sollicitatie forms.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account, e.g.
# "Lotus Vitaal <noreply@lotusvitaal.com>". This is a technical sender address,
# not the business's real published contact email — do not reuse CONTACT_EMAIL
# here.
RESEND_FROM_EMAIL=

# Where contact- and kennismaken-form notifications are delivered.
# Intended company inbox: info@lotusvitaal.com (set the real value in .env.local).
CONTACT_EMAIL=

# Where sollicitatie-form notifications are delivered.
# Intended company inbox: info@lotusvitaal.com (set the real value in .env.local).
APPLICATION_EMAIL=

# Vercel Blob (https://vercel.com/docs/vercel-blob) — private storage for
# uploaded cv files on the sollicitatie form. Get this from the Vercel
# dashboard once a Blob store is created for this project; it's also set
# automatically in Vercel deployments with a Blob store attached.
BLOB_READ_WRITE_TOKEN=
